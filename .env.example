APP_NAME=FIXMATE
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Laravel Reverb (WebSocket) — live chat real-time.
# Jalankan server dengan: php artisan reverb:start
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Port Reverb mendengarkan (di dalam server/container)
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Target publikasi sisi-server (Laravel → Reverb).
# Dev lokal: sama dengan server. Production (container): 127.0.0.1:8080 (http).
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# Alamat yang dipakai browser (Echo). Kosongkan di dev (ikut REVERB_HOST).
# Production di belakang TLS/proxy: REVERB_CLIENT_HOST=domainmu, PORT=443, SCHEME=https.
REVERB_CLIENT_HOST=
REVERB_CLIENT_PORT=
REVERB_CLIENT_SCHEME=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Analisis foto AI. AI_PROVIDER: gemini (gratis, dari aistudio.google.com) atau anthropic (Claude).
# Kosongkan key untuk menonaktifkan analisis foto.
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
